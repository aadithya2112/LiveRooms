{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "liverooms-signaling",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-28",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room"],
    },
  ],
  "vars": {
    "TURN_ENABLED": "false",
    "ALLOWED_ORIGINS": "https://rooms.aadithya.dev,https://live-rooms.vercel.app",
  },
  "ratelimits": [
    {
      "name": "CONNECTION_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
    },
  },
  "account_id": "43aaa59487afe2196898085249f0f2a2",
  "workers_dev": true,
  "preview_urls": false,
}
